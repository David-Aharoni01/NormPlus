    <string name="daydetail_sleep_card">The night\'s sleep</string>
    <string name="daydetail_sleep_card_empty">No sleep was recorded for the night that ended this day.</string>
    <string name="daydetail_asleep">asleep</string>
    <string name="daydetail_asleep_note">Asleep counts deep and light sleep.</string>
    <string name="daydetail_stage_deep">Deep</string>
    <string name="daydetail_stage_light">Light</string>
    <string name="daydetail_stage_awake">Awake</string>
    <plurals name="daydetail_sessions">
        <item quantity="one">%1$d session</item>
        <item quantity="other">%1$d sessions</item>
    </plurals>
    <string name="daydetail_sessions_separator">" · "</string>
    <string name="daydetail_band_spoken">Sleep from %1$s to %2$s: %3$s asleep, deep %4$s, light %5$s, awake %6$s.</string>
    <string name="daydetail_sleep_card_spoken">The night\'s sleep, %1$s asleep, %2$s. Deep %3$s, light %4$s, awake %5$s.</string>

