        <item quantity="one">%1$s step</item>
        <item quantity="other">%1$s steps</item>
    </plurals>
    <plurals name="daydetail_half_hours">
        <item quantity="one">%1$d half hour recorded</item>
        <item quantity="other">%1$d half hours recorded</item>
    </plurals>

