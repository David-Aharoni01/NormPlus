<?xml version="1.0" encoding="utf-8"?>
<!-- Day detail (#101): a past day, from History's rows and Today's Yesterday row. See docs/app.md, "UI Layer". -->
<resources>
    <!-- The title: Today, Yesterday, or the short date. -->
    <string name="daydetail_title">Day</string>
    <string name="daydetail_today">Today</string>
    <string name="daydetail_yesterday">Yesterday</string>
    <string name="daydetail_title_pattern" translatable="false">EEE d MMM</string>
    <string name="daydetail_title_year_pattern" translatable="false">EEE d MMM yyyy</string>
    <!-- The date line under the title, for a day in another year. -->
    <string name="daydetail_date_year_pattern" translatable="false">EEEE · d MMMM yyyy</string>

    <!-- Moving between days: the header's buttons, and what the swipe does. -->
    <string name="daydetail_previous">Previous day</string>
    <string name="daydetail_next">Next day</string>

    <!-- The hero card, for a day that is over: the goal, and how far short of it. -->
    <string name="daydetail_of_goal_short">of %1$s · %2$s short</string>
    <!-- Today's date: the records so far, as of the last sync. -->
    <string name="daydetail_so_far">So far, from the sync at %1$s</string>
    <string name="daydetail_so_far_none">So far. Nothing synced today yet.</string>

    <!-- The tiles' labels. -->
    <string name="daydetail_sleep">Sleep</string>
    <string name="daydetail_heart_rate">Heart rate</string>
    <string name="daydetail_calories">Calories</string>
    <string name="daydetail_distance">Distance</string>

    <!-- Units set small beside a figure. -->
    <string name="daydetail_unit_steps">steps</string>
    <string name="daydetail_unit_bpm">bpm</string>
    <string name="daydetail_unit_kcal">kcal</string>
    <string name="daydetail_unit_km">km</string>
    <string name="daydetail_unit_mi">mi</string>

    <!-- In place of a figure with no record behind it. Never a zero. -->
    <string name="daydetail_sleep_absent">No sleep recorded</string>
    <string name="daydetail_heart_rate_absent">No readings</string>
    <string name="daydetail_not_synced">Not synced</string>

    <!-- The tiles' detail lines. -->
    <string name="daydetail_sleep_deep">deep %1$s</string>
    <string name="daydetail_span">%1$s–%2$s</string>
