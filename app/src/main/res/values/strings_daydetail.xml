    <string name="daydetail_steps_chart">Steps by the half hour</string>
    <string name="daydetail_busiest">in the busiest half hour, %1$s · %2$s</string>
    <string name="daydetail_steps_chart_empty">No steps were synced for this day.</string>
    <string name="daydetail_steps_chart_spoken">Steps by the half hour. %1$s in all. Busiest half hour %2$s, %3$s.</string>
    <string name="daydetail_steps_chart_spoken_still">Steps by the half hour. %1$s in all, none in any one half hour.</string>
