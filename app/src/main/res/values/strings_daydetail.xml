    <string name="daydetail_active">active %1$s</string>

    <!-- TalkBack reads each tile and card as one sentence. -->
    <string name="daydetail_spoken">%1$s, %2$s</string>
    <string name="daydetail_spoken_with_detail">%1$s, %2$s, %3$s</string>
    <string name="daydetail_spoken_span">from %1$s to %2$s</string>
    <string name="daydetail_spoken_asleep">%1$s asleep</string>
    <string name="daydetail_spoken_heart_average">average %1$s bpm, from %2$s to %3$s</string>

