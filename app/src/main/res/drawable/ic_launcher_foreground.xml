<?xml version="1.0" encoding="utf-8"?>
<!--
    The Norm+ launcher icon's foreground (#96), our own drawing: the top sheet of a tear-off
    day pad, with its stub and one perforated hairline, and on it a pair of watch hands (the
    Norm 2 has real ones) meeting at a calendar-red pivot, the red-letter mark.

    108 dp canvas; everything stays inside the 66 dp safe circle (21..87), so no launcher mask
    cuts it: the sheet's farthest corner is 30.5 dp from the centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The sheet: square at the bound top, the lightest round below. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,31 L74,31 L74,75 Q74,77 72,77 L36,77 Q34,77 34,75 Z"/>

    <!-- The stub above the perforation, a shade of the backing on the paper. -->
    <path
        android:fillColor="#E1E5EE"
        android:pathData="M34,31 L74,31 L74,37.4 L34,37.4 Z"/>

    <!-- The perforation: one dashed hairline across the sheet. -->
    <path
        android:fillColor="#7C88A6"
        android:pathData="M35,37.4 h2.4 v1.1 h-2.4 Z M39,37.4 h2.4 v1.1 h-2.4 Z M43,37.4 h2.4 v1.1 h-2.4 Z
            M47,37.4 h2.4 v1.1 h-2.4 Z M51,37.4 h2.4 v1.1 h-2.4 Z M55,37.4 h2.4 v1.1 h-2.4 Z
            M59,37.4 h2.4 v1.1 h-2.4 Z M63,37.4 h2.4 v1.1 h-2.4 Z M67,37.4 h2.4 v1.1 h-2.4 Z
            M71,37.4 h2 v1.1 h-2 Z"/>

    <!-- The hour hand, towards ten. -->
    <group
        android:pivotX="54"
        android:pivotY="58"
        android:rotation="-58">
        <path
            android:fillColor="#1F2A44"
            android:pathData="M51.7,47.5 A2.3,2.3 0 0,1 56.3,47.5 L56.3,58 A2.3,2.3 0 0,1 51.7,58 Z"/>
    </group>

    <!-- The minute hand, towards two. -->
    <group
        android:pivotX="54"
        android:pivotY="58"
        android:rotation="60">
        <path
            android:fillColor="#1F2A44"
            android:pathData="M52.4,42.6 A1.6,1.6 0 0,1 55.6,42.6 L55.6,58 A1.6,1.6 0 0,1 52.4,58 Z"/>
    </group>

    <!-- The pivot, in calendar red. -->
    <path
        android:fillColor="#D62828"
        android:pathData="M54,54.6 A3.4,3.4 0 1,1 53.99,54.6 Z"/>
</vector>
