<?xml version="1.0" encoding="utf-8"?>
<!--
    The Norm+ launcher icon's foreground (#96), our own drawing: the watch as the Watch tab
    draws it. A violet ring, a grey bezel, the black display, and the two physical hands (the
    Norm 2 has no second hand) at twelve and four, an L that reads as a clock and never as a
    tick, round a violet pivot.

    108 dp canvas; everything stays inside the 66 dp safe circle (r 33 about 54,54): the
    ring's outer edge is at r 31.2, so no launcher mask cuts it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The violet ring. -->
    <path
        android:strokeColor="#A68BFF"
        android:strokeWidth="2.4"
        android:fillColor="#00000000"
        android:pathData="M54,24 A30,30 0 1,1 53.99,24 Z"/>

    <!-- The bezel, its lighter edge, and the display. -->
    <path android:fillColor="#3A3C42" android:pathData="M54,27.5 A26.5,26.5 0 1,1 53.99,27.5 Z"/>
    <path
        android:strokeColor="#55585F"
        android:strokeWidth="0.8"
        android:fillColor="#00000000"
        android:pathData="M54,27.9 A26.1,26.1 0 1,1 53.99,27.9 Z"/>
    <path android:fillColor="#000000" android:pathData="M54,31 A23,23 0 1,1 53.99,31 Z"/>

    <!-- The hour hand, towards four. -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path
            android:fillColor="#E9EAEE"
            android:pathData="M51.9,40.5 A2.1,2.1 0 0,1 56.1,40.5 L56.1,57 A2.1,2.1 0 0,1 51.9,57 Z"/>
    </group>

    <!-- The minute hand, at twelve. -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path
            android:fillColor="#E9EAEE"
            android:pathData="M52.6,35 A1.4,1.4 0 0,1 55.4,35 L55.4,57.5 A1.4,1.4 0 0,1 52.6,57.5 Z"/>
    </group>

    <!-- The pivot: a cap in the hands' colour with a violet centre. -->
    <path android:fillColor="#E9EAEE" android:pathData="M54,50.6 A3.4,3.4 0 1,1 53.99,50.6 Z"/>
    <path android:fillColor="#A68BFF" android:pathData="M54,52.5 A1.5,1.5 0 1,1 53.99,52.5 Z"/>
</vector>
