<?xml version="1.0" encoding="utf-8"?>
<!--
    The Norm+ launcher icon's background (#96): Dark Dial's near-black ground with its one
    soft violet glow, centred behind the dial. Our own drawing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="@color/ic_launcher_background" android:pathData="M0,0h108v108h-108z"/>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46">
                <item android:offset="0" android:color="#663D2A99"/>
                <item android:offset="0.55" android:color="#262A1D66"/>
                <item android:offset="1" android:color="#000B0C0F"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
