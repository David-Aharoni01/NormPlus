    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ring and the bezel's edge. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:fillColor="#00000000"
        android:pathData="M54,24 A30,30 0 1,1 53.99,24 Z"/>
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:pathData="M54,29 A25,25 0 1,1 53.99,29 Z"/>

    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M51.9,40.5 A2.1,2.1 0 0,1 56.1,40.5 L56.1,57 A2.1,2.1 0 0,1 51.9,57 Z"/>
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M52.6,35 A1.4,1.4 0 0,1 55.4,35 L55.4,57.5 A1.4,1.4 0 0,1 52.6,57.5 Z"/>
    </group>
    <path android:fillColor="#FFFFFFFF" android:pathData="M54,50.6 A3.4,3.4 0 1,1 53.99,50.6 Z"/>
</vector>
