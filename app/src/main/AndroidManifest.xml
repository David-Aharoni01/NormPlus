<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <!-- Always-on uptime: restart the connection service after a reboot or an app update, and ask
         the user to exempt us from Doze/battery optimisation (an exempt app may also start its
         foreground service from the background, which is what the watchdog needs). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phone-call support: detect call state + caller number, resolve names, answer/reject from watch. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!--
      Package visibility (API 30+): the notification-whitelist picker lists the apps the user can
      choose to forward. Declaring the launcher intent makes every *launchable* app visible to
      PackageManager, which is exactly the set a user recognises. We deliberately do NOT request
      QUERY_ALL_PACKAGES — it is Play-policy-restricted and unnecessary for this use case; apps with
      no launcher entry are simply not offered (an app that already has a rule is still listed by
      package name, see InstalledAppsRepository).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".Norm2Application"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NormPlus">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NormPlus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ble.BleService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <!-- Auto-start after a reboot / app update. directBootAware so LOCKED_BOOT_COMPLETED is
             actually delivered; the receiver itself defers real work until the user unlocks (our
             DataStore is credential-protected). -->
        <receiver
            android:name=".ble.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Periodic AlarmManager watchdog (explicit intent only — no filter needed). -->
        <receiver
            android:name=".ble.ConnectionWatchdogReceiver"
            android:exported="false" />

        <service
            android:name=".notification.NotificationForwarder"
            android:label="@string/notification_listener_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
